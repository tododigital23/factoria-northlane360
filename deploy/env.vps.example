# Copia este archivo a .env en la raíz del paquete (junto a docker-compose.yml).

# --- Dominio de la web (el que ve el navegador) ---
ELIOT_FRONTEND_ORIGINS=https://app.tu-dominio.com
ELIOT_FRONTEND_ORIGIN=https://app.tu-dominio.com
# Vacío = el navegador llama al mismo dominio (nginx enruta /v1 al API).
# Si la web va a un hosting estático aparte, pon aquí https://api.tu-dominio.com
VITE_API_ROOT=
FACTORIA_HTTP_PORT=80

# --- Auth0 ---
VITE_AUTH0_DOMAIN=tu-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.eliot.internal
ELIOT_OIDC_JWKS_URL=https://tu-tenant.eu.auth0.com/.well-known/jwks.json
ELIOT_OIDC_ISSUER=https://tu-tenant.eu.auth0.com/
ELIOT_OIDC_AUDIENCE=https://api.eliot.internal

# --- Postgres del VPS (recomendado para el producto completo) ---
POSTGRES_PASSWORD=cambia-esta-clave-postgres
ELIOT_IDENTITY_DB_PASSWORD=cambia-esta-clave-identity
ELIOT_DB_NAME=eliot_dev
ELIOT_DB_STRICT_ACCOUNTS=on
ELIOT_BOOTSTRAP_SUBJECT=
ELIOT_HOLDING_NAME=Superempresa Freddy
ELIOT_AUTO_PROVISION_USER=off

# --- Opcional: otra base para La Factoría (MySQL / MariaDB / SQLite) ---
# En ese caso no uses el servicio postgres del compose; arranca solo api+web
# y pon ELIOT_DB_STRICT_ACCOUNTS=off. El trabajo documental sigue exigiendo Postgres.
# DATABASE_URL=mysql://factoria:clave@127.0.0.1:3306/factoria
# DATABASE_URL=sqlite:////var/lib/factoria/factoria.db
# ELIOT_DB_ENGINE=mysql

# --- Cerebro y Freddy ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELIOT_TELEGRAM_BOT_TOKEN=
ELIOT_TELEGRAM_CHAT_ID=
ELIOT_DEMO_KEY=

# Empresas conectadas por HTTP o por base de datos. Ver README §8 y §12.
ELIOT_PORTAL_FEEDS=
