# Variables del servicio API en Railway (Variables → Shared o del servicio api).

ELIOT_ENABLE_ORGANIZATIONS_API=true
ELIOT_DB_ENGINE=postgresql
ELIOT_DB_STRICT_ACCOUNTS=off
ELIOT_AUTO_PROVISION_USER=on
ELIOT_BOOTSTRAP_SUBJECT=https://tu-tenant.eu.auth0.com/|auth0|TU_USER_ID
ELIOT_HOLDING_NAME=Superempresa Freddy

# DATABASE_URL la pone Railway al conectar el plugin PostgreSQL. No la escribas a mano.

# Tras el primer deploy, sustituye por las URLs .up.railway.app reales
# o usa referencias: https://${{web.RAILWAY_PUBLIC_DOMAIN}}
ELIOT_FRONTEND_ORIGINS=https://CAMBIAR.up.railway.app
ELIOT_FRONTEND_ORIGIN=https://CAMBIAR.up.railway.app

ELIOT_OIDC_JWKS_URL=https://tu-tenant.eu.auth0.com/.well-known/jwks.json
ELIOT_OIDC_ISSUER=https://tu-tenant.eu.auth0.com/
ELIOT_OIDC_AUDIENCE=https://api.eliot.internal

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELIOT_TELEGRAM_BOT_TOKEN=
ELIOT_TELEGRAM_CHAT_ID=
ELIOT_PORTAL_FEEDS=
ELIOT_DEMO_KEY=
