# Solo hosting, sin VPS. El API corre como «aplicación Python» del panel (Passenger).
# La web va a public_html / un subdominio estático. La base es MySQL o MariaDB del panel.

ELIOT_ENABLE_ORGANIZATIONS_API=true
ELIOT_DB_ENGINE=mysql
ELIOT_DB_STRICT_ACCOUNTS=off
ELIOT_AUTO_PROVISION_USER=on
ELIOT_BOOTSTRAP_SUBJECT=https://tu-tenant.eu.auth0.com/|auth0|TU_USER_ID
ELIOT_HOLDING_NAME=Superempresa Freddy

# Usuario y base que crea el panel (cPanel → MySQL).
DATABASE_URL=mysql://USUARIO_MYSQL:CLAVE@localhost:3306/NOMBRE_BASE

# Origen público de la web (https, sin barra final).
ELIOT_FRONTEND_ORIGINS=https://app.tu-dominio.com
ELIOT_FRONTEND_ORIGIN=https://app.tu-dominio.com

ELIOT_OIDC_JWKS_URL=https://tu-tenant.eu.auth0.com/.well-known/jwks.json
ELIOT_OIDC_ISSUER=https://tu-tenant.eu.auth0.com/
ELIOT_OIDC_AUDIENCE=https://api.eliot.internal

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELIOT_TELEGRAM_BOT_TOKEN=
ELIOT_TELEGRAM_CHAT_ID=
ELIOT_PORTAL_FEEDS=
ELIOT_DEMO_KEY=
